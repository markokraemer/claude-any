{
  "name": "claude-any",
  "version": "0.2.0",
  "description": "Run Claude Code on any Anthropic Messages API endpoint or on GPT models from your ChatGPT plan, and switch between all of them from /model.",
  "keywords": [
    "claude-code",
    "anthropic",
    "anthropic-messages-api",
    "llm-gateway",
    "router",
    "codex",
    "chatgpt",
    "cli",
    "model-picker"
  ],
  "homepage": "https://github.com/markokraemer/claude-any#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markokraemer/claude-any.git"
  },
  "bugs": {
    "url": "https://github.com/markokraemer/claude-any/issues"
  },
  "author": "Marko Kraemer",
  "license": "MIT",
  "type": "module",
  "bin": {
    "claude-any": "bin/claude-any"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --outfile dist/claude-any"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
